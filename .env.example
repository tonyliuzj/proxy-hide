# Generate independent 32-byte values, for example: openssl rand -base64 32
PROXYHIDE_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
PROXYHIDE_ENDPOINT_PEPPER=replace-with-a-long-random-secret
PROXYHIDE_SESSION_SECRET=replace-with-a-different-long-random-secret

POSTGRES_DB=proxyhide
POSTGRES_USER=proxyhide
POSTGRES_PASSWORD=proxyhide-dev
DATABASE_URL=postgresql+asyncpg://proxyhide:proxyhide-dev@postgres:5432/proxyhide
REDIS_URL=redis://redis:6379/0

WEB_ORIGIN=http://localhost:3000
API_INTERNAL_URL=http://api:8000
NEXT_PUBLIC_API_BASE=/api/v1
SESSION_COOKIE_SECURE=false

GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=9000
PUBLIC_SECURE_PROXY_HOST=localhost
PUBLIC_SECURE_PROXY_PORT=443
PUBLIC_PLAINTEXT_PROXY_HOST=localhost
PUBLIC_PLAINTEXT_PROXY_PORT=9000
TRUSTED_PROXY_CIDRS=

# Publish a controlled echo endpoint before enabling scheduled general checks.
PROBE_URL=http://api:8000/probe/v1/echo
# Optional. Country and ASN are populated when those fields exist in the database.
GEOIP_DATABASE_PATH=/data/geoip/GeoLite2-City.mmdb
LOG_LEVEL=INFO
